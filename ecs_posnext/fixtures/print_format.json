  "html": "<link href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Cairo:wght@500;700&display=swap\" rel=\"stylesheet\">\n\n<style>\n\n@page{\n    size:80mm auto;\n    margin:2mm;\n}\n\n*{\n    margin:0;\n    padding:0;\n    box-sizing:border-box;\n}\n\nhtml,\nbody{\n    width:80mm;\n    font-family:'IBM Plex Sans',sans-serif;\n    font-size:11px;\n    color:#000;\n    background:#fff;\n    -webkit-print-color-adjust:exact;\n    print-color-adjust:exact;\n}\n\n.receipt{\n    width:100%;\n    margin:0 auto;\n}\n\n/*======================\n        LOGO\n=======================*/\n\n.logo{\n    text-align:center;\n    margin-bottom:6px;\n}\n\n.logo img{\n    width:64mm;\n    max-height:38mm;\n    object-fit:contain;\n}\n\n.branch{\n    margin-top:5px;\n    border:1px solid #000;\n    padding:5px;\n    text-align:center;\n    font-family:'Cairo',sans-serif;\n    font-weight:700;\n    font-size:12px;\n}\n\n/*======================\n      HEADER INFO\n=======================*/\n\n.info-table{\n    width:100%;\n    border-collapse:collapse;\n    margin-top:3px;\n    margin-bottom:3px;\n}\n\n.info-table td{\n    padding:1px;\n    line-height:0.8;\n    vertical-align:top;\n     font-size: 13px !important;  \n}\n\n.info-table tr td:first-child{\n    font-size:8px;\n    font-weight:bold;\n}\n\n.info-table td:last-child{\n    text-align:left;\n}\n\n\n.line{\n    border-top:1px dashed #000;\n    margin:3px 0;\n}\n\n/*======================\n        ITEMS\n=======================*/\n\n.items{\n    width:100%;\n    border-collapse:collapse;\n    margin-top:4px;\n}\n\n.items thead th{\n\n    background:#d9d9d9;\n\n    border:1px solid #777;\n\n    padding:5px;\n\n    text-align:center;\n\n    font-size:13px;\n\n    font-weight:700;\n\n}\n\n.items tbody td{\n\n    border-bottom:1px dashed #bbb;\n    \n    text-align:center;\n    \n    padding:5px 3px;\n\n    font-size:13px;\n    \n    font-weight:600\n}\n\n.items tbody td:nth-child(1){\n\n    width:18%;\n\n    text-align:center;\n\n}\n\n.items tbody td:nth-child(2){\n\n    width:52%;\n\n    font-family:'Cairo',sans-serif;\n\n}\n\n.items tbody td:nth-child(3){\n\n    width:30%;\n\n    text-align:right;\n\n}\n\n/*======================\n       TOTALS\n=======================*/\n\n.totals{\n\n    width:100%;\n\n    border-collapse:collapse;\n\n    margin-top:8px;\n\n}\n\n.totals td{\n\n    padding:6px 4px;\n\n    border-bottom:1px solid #ddd;\n\n}\n\n.totals tr:nth-child(odd){\n\n    background:#f6f6f6;\n\n}\n\n.totals td:first-child{\n\n    font-weight:600;\n\n}\n\n.totals td:last-child{\n\n    text-align:right;\n\n    font-weight:700;\n\n}\n\n/*======================\n      NET TOTAL\n=======================*/\n\n.net{\n\n    margin-top:8px;\n\n    border-top:2px solid #000;\n\n    border-bottom:2px solid #000;\n\n    padding:8px 4px;\n\n}\n\n.net table{\n\n    width:100%;\n\n    border-collapse:collapse;\n\n}\n\n.net td:first-child{\n\n    font-size:15px;\n\n    font-weight:700;\n\n}\n\n.net td:last-child{\n\n    text-align:right;\n\n    font-size:24px;\n\n    font-weight:900;\n\n}\n\n/*======================\n      FOOTER\n=======================*/\n\n.message{\n\n    margin-top:8px;\n\n    border:1px solid #000;\n\n}\n\n.message-en{\n\n    background:#000;\n\n    color:#fff;\n\n    text-align:center;\n\n    padding:5px;\n\n    font-size:10px;\n\n    font-weight:bold;\n\n}\n\n.message-ar{\n\n    text-align:center;\n\n    padding:5px;\n\n    font-family:'Cairo',sans-serif;\n\n    font-size:10px;\n\n}\n\n.phone{\n\n    margin-top:6px;\n\n    background:#000;\n\n    color:#fff;\n\n    text-align:center;\n\n    padding:5px;\n\n    font-size:13px;\n\n    font-weight:bold;\n\n}\n\n.social{\n\n    margin-top:5px;\n\n    text-align:center;\n\n    font-size:9px;\n\n    word-break:break-word;\n\n}\n\n.qr{\n\n    margin-top:8px;\n\n    text-align:center;\n\n}\n\n.qr img{\n\n    width:90px;\n\n    height:90px;\n\n}\n\n</style>\n<main class=\"receipt\">\n\n    <!--======================\n            LOGO\n    =======================-->\n\n    <div class=\"logo\">\n\n        <img src=\"/api/method/ecs_s3_storage.utils.s3_file_storage.get_s3_file?key=hrg.erpcloud.systems%2Fpublic%2Ffiles%2Fimages%20%281%29373d51.jpeg\">\n\n        <div class=\"branch\">\n            {{ doc.pos_profile or \"\" }}\n        </div>\n\n    </div>\n\n    <!--======================\n        HEADER INFORMATION\n    =======================-->\n    <table class=\"info-table\">\n\n        <tr>\n            <td>Invoice No :</td>\n            <td>{{ doc.name }}</td>\n        </tr>\n\n        <tr>\n            <td>Date :</td>\n            <td>{{ frappe.utils.formatdate(doc.posting_date,\"dd-MM-yyyy\") }}</td>\n        </tr>\n\n        <tr>\n            <td>Time :</td>\n            <td>{{ doc.posting_time }}</td>\n        </tr>\n\n        <tr>\n            <td>Customer :</td>\n            <td>{{ doc.customer_name or doc.customer }}</td>\n        </tr>\n\n        <tr>\n\n            <td>Barber :</td>\n\n            <td>\n\n                {% if doc.sales_team %}\n\n                    {% for row in doc.sales_team %}\n\n                        {{ row.sales_person }}{% if not loop.last %}, {% endif %}\n\n                    {% endfor %}\n\n                {% endif %}\n\n            </td>\n\n        </tr>\n\n    </table>\n\n    <div class=\"line\"></div>\n\n    <!--======================\n            ITEMS\n    =======================-->\n\n    <table class=\"items\">\n\n        <thead>\n\n            <tr>\n\n                <th>Qty</th>\n\n                <th>Item</th>\n\n                <th>Total</th>\n\n            </tr>\n\n        </thead>\n\n        <tbody>\n\n            {% for item in doc.items %}\n\n            <tr>\n\n                <td>\n\n                    {{ frappe.utils.fmt_money(item.qty, precision=0).replace(\".00\",\"\") }}\n\n                </td>\n\n                <td>\n\n                    {{ item.item_name }}\n\n                </td>\n\n                <td>\n\n               {{ item.amount|int }}\n                </td>\n                \n\n            </tr>\n\n            {% endfor %}\n\n        </tbody>\n\n    </table>\n   \n\n    <!--======================\n          TOTALS\n    =======================-->\n\n    <table class=\"totals\">\n\n    <tr>\n        <td>Total</td>\n        <td>{{ doc.total|int }}</td>\n    </tr>\n\n    {% if doc.total_taxes_and_charges %}\n\n    <tr>\n        <td>Tax</td>\n        <td>{{ doc.total_taxes_and_charges|int }}</td>\n    </tr>\n\n    {% endif %}\n\n    {% if doc.discount_amount %}\n\n    <tr>\n        <td>Discount</td>\n        <td>{{ doc.discount_amount|int }}</td>\n    </tr>\n\n    {% endif %}\n\n</table>\n\n        {% if doc.discount_amount %}\n\n        <tr>\n            <td>Discount</td>\n            <td>- {{ frappe.utils.fmt_money(doc.discount_amount, currency=doc.currency) }}</td>\n        </tr>\n\n        {% endif %}\n\n    </table>\n\n    <!--======================\n          GRAND TOTAL\n    =======================-->\n\n    <div class=\"net\">\n\n        <table>\n\n            <tr>\n\n                <td>NET</td>\n\n                <td>{{ doc.grand_total|int}}</td>\n\n            </tr>\n\n        </table>\n\n    </div>\n\n    <!--======================\n         PAYMENT METHOD\n    =======================-->\n\n    <!--<table class=\"info-table\" style=\"margin-top:8px;\">-->\n\n    <!--    <tr>-->\n\n    <!--        <td>Payment</td>-->\n\n    <!--        <td>-->\n\n    <!--            {% if doc.payments %}-->\n\n    <!--                {% for p in doc.payments %}-->\n\n    <!--                    {{ p.mode_of_payment }}{% if not loop.last %}, {% endif %}-->\n\n    <!--                {% endfor %}-->\n\n    <!--            {% else %}-->\n\n    <!--                Cash-->\n\n    <!--            {% endif %}-->\n\n    <!--        </td>-->\n\n    <!--    </tr>-->\n\n    <!--</table>-->\n\n    <div class=\"line\"></div>\n\n    <!--======================\n            MESSAGE\n    =======================-->\n\n    <div class=\"message\">\n\n        <div class=\"message-en\">\n\n            THANK YOU FOR YOUR VISIT\n\n        </div>\n\n        <div class=\"message-ar\">\n\n            شكراً لزيارتكم ونتمنى رؤيتكم مرة أخرى\n\n        </div>\n\n    </div>\n\n    <div class=\"phone\">\n\n        Tel : 02-25190824\n\n    </div>\n\n    <div class=\"social\">\n\n        facebook.com/Heshamrabeaofficial\n\n    </div>\n\n    <!--======================\n             QR\n    =======================-->\n\n    <div class=\"qr\">\n\n        <img src=\"https://api.qrserver.com/v1/create-qr-code/?size=150x150&data={{ doc.name }}\">\n\n    </div>\n\n</main>\n    ",
